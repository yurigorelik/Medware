generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  PATIENT
  BOTH
  ADMIN
}

enum ConsultationStatus {
  ACTIVE
  SUMMARY_GENERATED
  UNDER_REVIEW
  COMPLETED
  CLOSED
}

enum MessageRole {
  SYSTEM
  ASSISTANT
  USER
}

enum VisitStatus {
  REQUESTED
  ACCEPTED
  BOOKED
  DECLINED
  CANCELLED
  COMPLETED
}

enum VisitModality {
  IN_PERSON
  VIDEO
}

enum VisitParty {
  PATIENT
  DOCTOR
}

enum SlotSource {
  CUSTOM
  EXISTING
}

model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  password               String?
  name                   String
  role                   Role
  isBlocked              Boolean        @default(false)
  emailVerified          Boolean        @default(false)
  emailVerificationToken String?        @unique
  passwordResetToken     String?        @unique
  passwordResetExpires   DateTime?
  lastActiveAt           DateTime?
  isDoctor               Boolean        @default(false)
  specialty              String?
  bio                    String?        @db.Text
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  accounts               Account[]
  doctorProfile          DoctorProfile?
  consultations          Consultation[]
  patientProfile         PatientProfile?
  doctorRatings          DoctorRating[]
  secondOpinions         SecondOpinion[]
  patientVisits          Visit[]        @relation("PatientVisits")
  doctorVisits           Visit[]        @relation("DoctorVisits")
  slots                  Slot[]         @relation("DoctorSlots")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PatientProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  dateOfBirth      String?
  gender           String?
  phone            String?
  address          String?
  emergencyContact String?
  preferredLanguage String?
  medicalHistory   String?  @db.Text
  currentMedications String? @db.Text
  allergies        String?  @db.Text
  pastProcedures   String?  @db.Text
  familyHistory    String?  @db.Text
  socialHistory    String?  @db.Text
  insuranceInfo    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DoctorProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id])
  specialty     String
  bio           String?
  description   String?        @db.Text
  licenseNumber String?
  photoUrl      String?
  clinicName    String?
  stampUrl      String?
  signatureUrl  String?
  portal        Portal?
  ratings       DoctorRating[]
}

model DoctorRating {
  id              String        @id @default(cuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  patientId       String
  patient         User          @relation(fields: [patientId], references: [id])
  rating          Int
  comment         String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([doctorProfileId, patientId])
  @@index([doctorProfileId])
  @@index([patientId])
}

model Portal {
  id                    String         @id @default(cuid())
  doctorProfileId       String         @unique
  doctorProfile         DoctorProfile  @relation(fields: [doctorProfileId], references: [id])
  name                  String
  medicalField          String
  instructions          String         @db.Text
  guidelines            String         @default("") @db.Text
  literature            String         @default("") @db.Text
  sources               String         @default("") @db.Text
  additionalDefinitions String         @default("") @db.Text
  welcomeMessage        String         @default("") @db.Text
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  consultations         Consultation[]
}

model Consultation {
  id                     String             @id @default(cuid())
  portalId               String
  portal                 Portal             @relation(fields: [portalId], references: [id])
  patientId              String
  patient                User               @relation(fields: [patientId], references: [id])
  status                 ConsultationStatus @default(ACTIVE)
  parentConsultationId   String?
  parentConsultation     Consultation?      @relation("FollowUp", fields: [parentConsultationId], references: [id])
  followUps              Consultation[]     @relation("FollowUp")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  messages               Message[]
  attachments            Attachment[]
  summary                CaseSummary?
  summaryLetter          SummaryLetter?
  prescriptions          Prescription[]
  documentRequests       DocumentRequest[]

  @@index([portalId])
  @@index([patientId])
  @@index([status])
  @@index([parentConsultationId])
}

model Message {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  role           MessageRole
  content        String       @db.Text
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([consultationId])
}

model Attachment {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  filename       String
  filepath       String
  mimetype       String
  size           Int
  createdAt      DateTime     @default(now())

  @@index([consultationId])
}

model CaseSummary {
  id                    String        @id @default(cuid())
  consultationId        String        @unique
  consultation          Consultation  @relation(fields: [consultationId], references: [id])
  summary               String        @db.Text
  differentialDiagnosis String        @db.Text
  suggestedWorkup       String        @db.Text
  createdAt             DateTime      @default(now())
  review                DoctorReview?
}

model DoctorReview {
  id                String      @id @default(cuid())
  summaryId         String      @unique
  summary           CaseSummary @relation(fields: [summaryId], references: [id])
  approved          Boolean     @default(false)
  followUpRequested Boolean     @default(false)
  editedSummary     String?     @db.Text
  editedDiagnosis   String?     @db.Text
  editedWorkup      String?     @db.Text
  doctorNotes       String?     @db.Text
  reviewedAt        DateTime    @default(now())
}

model SecondOpinion {
  id            String                @id @default(cuid())
  doctorId      String
  doctor        User                  @relation(fields: [doctorId], references: [id])
  patientName   String
  status        SecondOpinionStatus   @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  messages      SecondOpinionMessage[]

  @@index([doctorId])
}

enum SecondOpinionStatus {
  ACTIVE
  COMPLETED
}

model SecondOpinionMessage {
  id              String        @id @default(cuid())
  secondOpinionId String
  secondOpinion   SecondOpinion @relation(fields: [secondOpinionId], references: [id], onDelete: Cascade)
  role            MessageRole
  content         String        @db.Text
  inputTokens     Int           @default(0)
  outputTokens    Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([secondOpinionId])
}

model SummaryLetter {
  id             String       @id @default(cuid())
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  content        String       @db.Text
  doctorName     String
  clinicName     String?
  patientName    String
  patientId      String?
  createdAt      DateTime     @default(now())
}

model Prescription {
  id             String             @id @default(cuid())
  consultationId String
  consultation   Consultation       @relation(fields: [consultationId], references: [id])
  doctorName     String
  clinicName     String?
  patientName    String
  patientId      String?
  items          PrescriptionItem[]
  createdAt      DateTime           @default(now())

  @@index([consultationId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationName String
  dose           String?
  route          String?
  type           String?
  duration       String?
  instructions   String?

  @@index([prescriptionId])
}

enum DocumentRequestStatus {
  PENDING
  COMPLETED
  DECLINED
}

model DocumentRequest {
  id             String                @id @default(cuid())
  consultationId String
  consultation   Consultation          @relation(fields: [consultationId], references: [id])
  patientId      String
  requestType    String
  status         DocumentRequestStatus @default(PENDING)
  notes          String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([consultationId])
  @@index([patientId])
}

model Visit {
  id              String        @id @default(cuid())
  patientId       String
  patient         User          @relation("PatientVisits", fields: [patientId], references: [id])
  doctorId        String
  doctor          User          @relation("DoctorVisits", fields: [doctorId], references: [id])
  requestedBy     VisitParty
  status          VisitStatus   @default(REQUESTED)
  reason          String?       @db.Text
  modality        VisitModality @default(IN_PERSON)
  meetingLink     String?
  location        String?
  costCents       Int?
  currency        String        @default("USD")
  terms           String?       @db.Text
  slotSource      SlotSource?
  // The slot the patient secured for this visit. NOTE: no onDelete: Cascade —
  // removing the booked slot must not delete the visit.
  scheduledSlotId String?       @unique
  scheduledSlot   Slot?         @relation("ScheduledSlot", fields: [scheduledSlotId], references: [id])
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  termsAcceptedAt DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  cancelledAt     DateTime?
  cancelledBy     VisitParty?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // Slots created specifically for this visit (slotSource = CUSTOM).
  customSlots     Slot[]        @relation("CustomSlots")

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model Slot {
  id            String   @id @default(cuid())
  doctorId      String
  doctor        User     @relation("DoctorSlots", fields: [doctorId], references: [id])
  start         DateTime
  end           DateTime
  booked        Boolean  @default(false)
  // null = standing availability; set = custom slot offered for a specific visit.
  visitId       String?
  visit         Visit?   @relation("CustomSlots", fields: [visitId], references: [id])
  // Back-relation: the visit that secured this slot (if any).
  bookedByVisit Visit?   @relation("ScheduledSlot")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([doctorId])
  @@index([visitId])
  @@index([booked])
}

